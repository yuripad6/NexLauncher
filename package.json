{
  "name": "nexlauncher",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "vite build",
    "dist": "vite build && electron-builder --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "minecraft-launcher-core": "^3.18.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.nexlauncher.app",
    "productName": "NexLauncher",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  },
  "author": "NexLab",
  "description": "NexLauncher — Minecraft launcher by NexLab"
}
