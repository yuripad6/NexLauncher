{
  "name": "nexlauncher",
  "version": "0.1.0",
  "private": true,
  "description": "NexLauncher Minecraft launcher",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "desktop": "electron .",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron-builder": "^26.0.0",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "ru.nexlauncher.app",
    "productName": "NexLauncher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
